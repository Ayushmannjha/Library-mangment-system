# Copy this file to .env and replace the values with your own.
# Never commit the real .env file.

# PostgreSQL connection (used by prisma.config.ts and PrismaService at runtime)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lms?schema=public"

# Server port (optional, defaults to 3000)
# PORT=3000

# JWT authentication
# Generate your own long random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET="CHANGE_ME_a_long_random_secret"
# Access token lifetime (short-lived)
JWT_EXPIRES_IN="15m"
# Refresh token lifetime (long-lived)
JWT_REFRESH_EXPIRES_IN="7d"

# SMTP (email) — used to send the auto-generated student login credentials
# when a student is admitted via POST /students.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="you@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Library Management <no-reply@example.com>"
# Where the student portal frontend is hosted (used in emails)
STUDENT_PORTAL_URL="http://localhost:4202"

# Comma-separated allowed browser origins (admin frontend + student portal).
# When unset, the API defaults to localhost origins on ports 3000/4000/4201/4202.
# CORS_ORIGINS="http://localhost:3000,http://localhost:4201,http://localhost:4202"
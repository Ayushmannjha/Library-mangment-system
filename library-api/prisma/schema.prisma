// Prisma 7 schema — introspected from the LIVE PostgreSQL database
// (`lms`) via `prisma db pull`, so it exactly matches the real tables.
// After FUTURE schema edits (adding columns), run `npx prisma db push` to
// apply them, then `npx prisma generate` to refresh the typed client.

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  // partialIndexes is auto-enabled because the DB uses partial unique
  // constraints (WHERE ... IS NOT NULL) that Prisma must represent.
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Libraries are the SaaS tenants. There is NO deleted_at column in the DB;
// lifecycle is handled through `status` (ACTIVE / INACTIVE — enforced by
// ck_libraries_status check). "Deleting" a library sets status = INACTIVE.
model libraries {
  id                                BigInt                 @id(map: "pk_libraries") @default(autoincrement())
  name                              String                 @db.VarChar(150)
  code                              String                 @unique(map: "uq_libraries_code") @db.VarChar(50)
  email                             String?                @db.VarChar(150)
  phone                             String?                @db.VarChar(20)
  address                           String?
  city                              String?                @db.VarChar(100)
  status                            String                 @default("ACTIVE") @db.VarChar(20)
  created_by                        BigInt?
  created_at                        DateTime               @default(now()) @db.Timestamptz(6)
  updated_by                        BigInt?
  updated_at                        DateTime               @default(now()) @db.Timestamptz(6)
  attendance                        attendance[]
  fee_plans                         fee_plans[]
  invoices                          invoices[]
  users_libraries_created_byTousers users?                 @relation("libraries_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_libraries_created_by")
  users_libraries_updated_byTousers users?                 @relation("libraries_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_libraries_updated_by")
  library_subscriptions             library_subscriptions?
  payments                          payments[]
  roles                             roles[]
  seat_bookings                     seat_bookings[]
  seats                             seats[]
  students                          students[]
  time_slots                        time_slots[]
  users_users_library_idTolibraries users[]                @relation("users_library_idTolibraries")

  @@index([name], map: "ix_libraries_name")
  @@index([status], map: "ix_libraries_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance {
  id                                 BigInt         @id(map: "pk_attendance") @default(autoincrement())
  library_id                         BigInt
  student_id                         BigInt
  booking_id                         BigInt?
  attendance_date                    DateTime       @db.Date
  check_in_at                        DateTime       @db.Timestamptz(6)
  check_out_at                       DateTime?      @db.Timestamptz(6)
  attendance_status                  String         @default("PRESENT") @db.VarChar(20)
  check_in_method                    String         @default("QR") @db.VarChar(20)
  qr_token                           String?        @unique(map: "ux_attendance_qr_token", where: raw("(qr_token IS NOT NULL)")) @db.VarChar(255)
  remarks                            String?
  created_at                         DateTime       @default(now()) @db.Timestamptz(6)
  created_by                         BigInt?
  updated_at                         DateTime       @default(now()) @db.Timestamptz(6)
  updated_by                         BigInt?
  seat_bookings                      seat_bookings? @relation(fields: [booking_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_attendance_booking")
  users_attendance_created_byTousers users?         @relation("attendance_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_attendance_created_by")
  libraries                          libraries      @relation(fields: [library_id], references: [id], onUpdate: NoAction, map: "fk_attendance_library")
  students                           students       @relation(fields: [student_id], references: [id], onUpdate: NoAction, map: "fk_attendance_student")
  users_attendance_updated_byTousers users?         @relation("attendance_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_attendance_updated_by")

  @@index([booking_id], map: "ix_attendance_booking_id")
  @@index([attendance_date], map: "ix_attendance_date")
  @@index([library_id, attendance_date], map: "ix_attendance_library_date")
  @@index([library_id], map: "ix_attendance_library_id")
  @@index([qr_token], map: "ix_attendance_qr_token")
  @@index([attendance_status], map: "ix_attendance_status")
  @@index([student_id], map: "ix_attendance_student_id")
}

